---
import { getConfig } from '@libs/config'
import { getChassisDocsPath } from '@libs/path'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
---

<div class="home-section py-3xlarge medium:py-6xlarge">
  <div class="container 2xlarge section-content py-3xlarge medium:py-6xlarge">
    <div class="row justify-content-center mb-3xlarge medium:mb-6xlarge">
      <header class="section-header col xlarge:col-10 text-center">
        <p
          class="module-title fg-primary medium:font-xlarge font-mass text-uppercase mb-xsmall medium:mb-small"
        >
          CHASSIS ASSETS
        </p>
        <h1 class="font-hero mb-small medium:mb-medium large:mb-large">
          <span class="font-normal">Ship Assets to</span>
          <span class="d-block">Every Brand, Every Platform</span>
        </h1>
        <p class="font-lead mb-medium medium:mb-large">
          Build system for processing design assets into platform-ready distributions. Handles file
          naming, resolution variants, and folder structure conventions across platforms.
        </p>
      </header>
    </div>

    <div
      class="section-features d-flex flex-column gap-medium mb-medium medium:mb-large col large:col-6 large:offset-3"
    >
      <!-- Code snippet -->
      <Code
        noToolbar
        lang="bash"
        code="git clone git@github.com:chassis-ui/tokens.git"
        containerClass="medium:mx-auto"
      />
      <!-- Buttons -->
      <div class="d-grid medium:d-flex gap-medium medium:justify-content-center flex-wrap">
        <a href={getChassisDocsPath('')} class="button primary large">
          <Icon name="book-open-outline" />
          <span>Get Started</span>
        </a>
        <a href={getConfig().repo} class="button default large" target="_blank" rel="noopener">
          <Icon name="github-brand" />
          <span>View on GitHub</span>
        </a>
      </div>

      <!-- Version info -->
      <p class="fg-subtle mb-0 text-center font-medium">
        Currently <strong>v{getConfig().current_version}</strong>
        <span class="px-2xsmall">&middot;</span>
        <a href={getConfig().repo + '/blob/main/CHANGELOG.md'} class="link-secondary text-nowrap"
          >Changes</a
        >
      </p>
    </div>
  </div>
</div>
