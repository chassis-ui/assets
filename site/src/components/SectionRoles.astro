---

<section class="bg-even py-6xlarge">
  <div class="container py-6xlarge">
    <div class="row justify-content-center mb-5xlarge">
      <div class="col-large-8 text-center my-4xlarge">
        <h2 class="font-hero mb-medium">Built for Your Team</h2>
        <p class="font-lead">
          Whether you're managing product strategy, crafting user experiences, or building
          applications, Chassis Assets streamlines your workflow and eliminates manual asset
          management.
        </p>
      </div>
    </div>

    <div class="row pb-6xlarge">
      <!-- Product Managers -->
      <div class="col-large-4">
        <div class="feature-thumb">
          <svg class="icon feature-icon"><use href="#briefcase-outline"></use></svg>
        </div>
        <h3 class="h4 mb-medium">Product Managers</h3>
        <ul class="list-group list-unstyled">
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Launch new brands with overrides in minutes</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Maintain visual consistency across portfolio</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Ship products faster with reusable asset libraries</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Reduce coordination overhead between teams</span>
          </li>
        </ul>
      </div>

      <!-- Designers -->
      <div class="col-large-4">
        <div class="feature-thumb">
          <svg class="icon feature-icon"><use href="#palette-outline"></use></svg>
        </div>
        <h3 class="h4 mb-medium">Designers</h3>
        <ul class="list-group list-unstyled">
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Export once, deploy everywhere automatically</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Perfect handoff with platform-native formats</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Focus on design, not manual file organization</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Brand-specific overrides without duplication</span>
          </li>
        </ul>
      </div>

      <!-- Developers -->
      <div class="col-large-4">
        <div class="feature-thumb">
          <svg class="icon feature-icon"><use href="#code-outline"></use></svg>
        </div>
        <h3 class="h4 mb-medium">Developers</h3>
        <ul class="list-group list-unstyled">
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Automated asset processing with zero config</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Naming conventions applied automatically</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Works with any tech stack or build system</span>
          </li>
          <li class="d-flex gap-small">
            <span class="icon icon-check-circle-outline success-icon-main"></span>
            <span>Validated distributions ready to deploy</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
