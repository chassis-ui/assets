{
  "name": "@chassis-ui/assets",
  "version": "0.1.6",
  "description": "A multi-brand, multi-product asset management system for distributing fonts, images, icons, and other design files across web, iOS, and Android platforms.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/assets.git"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/assets/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "chassis": {
    "defaults": {
      "brandFolder": "default"
    },
    "build": {
      "brands": [
        "chassis",
        "example"
      ],
      "apps": {
        "docs": [
          "web"
        ],
        "demo": [
          "ios",
          "android"
        ]
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "chassis",
    "design system",
    "design assets"
  ],
  "files": [
    "source/**/*",
    "build/**/*",
    "!source/**/.DS_Store",
    "!.DS_Store"
  ],
  "scripts": {
    "build": "pnpm site:build",
    "clean": "pnpm site:clean && rm -rf dist || true",
    "dev": "pnpm assets:site && pnpm astro:dev",
    "assets": "node build/build-assets.js",
    "assets:analyze": "node build/analyze-assets.js",
    "assets:lint": "eslint build --cache --cache-location .cache/.eslintcache",
    "assets:test": "node test/build.test.js && node test/analyze.test.js && node test/api.test.js",
    "assets:test:build": "node test/build.test.js",
    "assets:test:analyze": "node test/analyze.test.js",
    "assets:test:api": "node test/api.test.js",
    "assets:site": "pnpm assets --clean --brand chassis --app docs",
    "assets:validate": "node build/validate-assets.js",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "pnpm assets:site && pnpm astro:build && pnpm site:pagefind",
    "site:clean": "rm -rf _site site/node_modules site/.astro site/public",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:fusv && pnpm site:lint:stylelint && pnpm site:lint:prettier",
    "site:lint:fusv": "find-unused-sass-variables site/src/scss/",
    "site:lint:eslint": "eslint site --cache --cache-location .cache/.eslintcache --report-unused-disable-directives",
    "site:lint:stylelint": "stylelint site/\"**/*.{css,scss}\" --cache --cache-location .cache/.stylelintcache",
    "site:lint:prettier": "prettier site -c --cache",
    "site:lint:html": "node build/html-validate.js",
    "site:lint:vnu": "node build/vnu-jar.js",
    "site:pagefind": "pagefind --site _site --output-subdir assets/pagefind",
    "astro:dev": "astro dev --root site --port 4325",
    "astro:build": "astro build --root site",
    "astro:preview": "astro preview --root site",
    "check": "pnpm check:lockfile & pnpm check:pnpm & wait",
    "check:astro": "astro check --root site",
    "check:lockfile": "lockfile-lint --allowed-hosts npm --allowed-schemes https: --empty-hostname false --type npm --path package-lock.json",
    "check:pnpm": "pnpm audit --audit-level moderate",
    "change-version": "node build/change-version.js"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@chassis-ui/css": "^0.3.2",
    "@chassis-ui/docs": "^0.3.6",
    "@chassis-ui/icons": "^0.3.0",
    "@chassis-ui/tokens": "^0.3.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.7.6",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.1",
    "@stackblitz/sdk": "^1.11.1",
    "@types/mdast": "^4.0.4",
    "astro": "^7.0.6",
    "autoprefixer": "^10.5.2",
    "clipboard": "^2.0.11",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^70.0.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.7.0",
    "globby": "^16.2.0",
    "html-validate": "^11.5.5",
    "htmlparser2": "^12.0.0",
    "js-yaml": "^5.2.1",
    "lockfile-lint": "^5.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.16",
    "postcss-prefix-custom-properties": "^0.1.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-autolink-headings": "^7.1.0",
    "sass": "^1.101.0",
    "standard": "^17.1.2",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vanilla-calendar-pro": "^3.1.0",
    "vnu-jar": "26.7.3",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "type": "module"
}
