{
  "buildCommand": "pnpm site:build",
  "outputDirectory": "_site",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  },
  "rewrites": [{ "source": "/assets/static/(.*)", "destination": "/static/$1" }],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "host", "value": ".*-staging\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
