{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["build"],
  "exclude": [
    "build/analyze-assets.js",
    "build/build-site.js",
    "build/change-version.js",
    "build/html-validate.js",
    "build/vnu-jar.js"
  ]
}
