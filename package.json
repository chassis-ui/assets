{
  "name": "@ozgurgunes/chassis-assets",
  "version": "0.1.0",
  "description": "Design assets for Chassis Design System. Distribute and manage design assets efficiently.",
  "license": "MIT",
  "homepage": "https://github.com/ozgurgunes/chassis-assets",
  "keywords": [
    "chassis",
    "design system",
    "design assets"
  ],
  "files": [
    "source/**/*",
    "build/**/*",
    "!source/**/.DS_Store",
    "!.DS_Store"
  ],
  "chassis": {
    "defaults": {
      "brandFolder": "default"
    },
    "build": {
      "brands": [
        "chassis",
        "test"
      ],
      "apps": {
        "docs": [
          "web"
        ],
        "test": [
          "ios",
          "android"
        ]
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dist": "node build/copy-assets.js",
    "build": "node build/copy-assets.js",
    "clean": "rm -rf dist",
    "validate": "eslint build/*.js",
    "test": "node test/build.test.js",
    "dev": "npm run clean && npm run build",
    "stats": "node build/analyze-assets.js",
    "release-version": "node build/bump-version.js",
    "release": "pnpm run clean && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "standard": "^17.1.0",
    "vnu-jar": "23.4.11"
  },
  "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4",
  "type": "module"
}