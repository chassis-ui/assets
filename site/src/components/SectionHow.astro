---
import Code from '@shortcodes/Code.astro'
---

<section class="bg-even py-6xlarge">
  <div class="container py-6xlarge">
    <div class="row justify-content-center mb-5xlarge">
      <div class="col-large-8 text-center">
        <h2 class="font-hero mb-medium">How It Works</h2>
        <p class="font-lead">
          Three simple steps from source assets to platform-ready distributions
        </p>
      </div>
    </div>

    <div class="row g-3xlarge">
      <!-- Step 1 -->
      <div class="col-large-4">
        <div class="card rounded-xlarge rounded-bottom-zero">
          <div class="card-content">
            <div class="text-center mb-small">
              <span class="font-3xlarge font-strong fg-primary">1</span>
            </div>
            <h3 class="h4 mb-medium text-center">Organize Assets</h3>
            <p class="text-center text-context-default-fg-subtle">
              Place your fonts, images, and icons in the <code>source/</code> directory. Organize by
              brand and app for automatic override handling.
            </p>
          </div>
        </div>
        <Code
          lang="text"
          code={`source/
├── default/
│   └── demo/
│       ├── Hero Img.png
│       └── Hero Img@2x.png
├── chassis/
│   └── demo/
│       └── Brand Logo.svg
└── example/
    └── demo/
        └── Brand Logo.svg`}
        />
      </div>
      <!-- Step 2 -->
      <div class="col-large-4">
        <div class="card rounded-xlarge rounded-bottom-zero">
          <div class="card-content">
            <div class="text-center mb-small">
              <span class="font-3xlarge font-strong fg-primary">2</span>
            </div>
            <h3 class="h4 mb-medium text-center">Build Distribution</h3>
            <p class="text-center text-context-default-fg-subtle">
              Run the build command to process and transform assets for each platform with
              platform-native conventions.
            </p>
          </div>
        </div>
        <Code
          lang="bash"
          code={`# Build all platforms
pnpm assets

# Build specific brand
pnpm assets --brand chassis

# Build specific app
pnpm assets --app demo

# Build with filters
pnpm assets --brand chassis --app demo`}
        />
      </div>

      <!-- Step 3 -->
      <div class="col-large-4">
        <div class="card rounded-xlarge rounded-bottom-zero">
          <div class="card-content">
            <div class="text-center mb-small">
              <span class="font-3xlarge font-strong fg-primary">3</span>
            </div>
            <h3 class="h4 mb-medium text-center">Use in Projects</h3>
            <p class="text-center text-context-default-fg-subtle">
              Copy or sync the generated <code>dist/</code> folder to your projects. Assets are organized
              and named following platform conventions.
            </p>
          </div>
        </div>
        <Code
          lang="text"
          code={`dist/
├── ios/chassis-demo/
│   ├── brand_logo.svg
│   ├── hero_img.png
│   └── hero_img@2x.png
└── android/chassis-demo/
    ├── drawable/
    │   ├── brand_logo.svg
    │   └── hero_img.png
    └── drawable_xhdpi/
        └── hero_img.png`}
        />
      </div>
    </div>
  </div>
</section>
