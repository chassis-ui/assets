{
  "name": "chassis-assets-workspace",
  "private": true,
  "description": "Workspace of @chassis-ui/assets, its source files and its documentation site",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/assets.git"
  },
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "chassis": {
    "defaults": {
      "brandFolder": "default"
    },
    "build": {
      "brands": [
        "chassis",
        "example"
      ],
      "apps": {
        "docs": [
          "web"
        ],
        "demo": [
          "ios",
          "android"
        ]
      }
    }
  },
  "bin": {
    "chassis-assets": "packages/assets/build/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm site:build",
    "clean": "pnpm site:clean && rm -rf dist || true",
    "dev": "pnpm assets:site && pnpm astro:dev",
    "test": "pnpm --filter @chassis-ui/assets test",
    "test:golden": "node packages/assets/build/cli.js build --cwd packages/assets/test/fixtures --out ../golden --quiet",
    "assets": "node packages/assets/build/cli.js build",
    "assets:analyze": "node packages/assets/build/cli.js analyze",
    "assets:lint": "eslint build packages/assets/build packages/assets/test --cache --cache-location .cache/.eslintcache",
    "assets:lint:source": "node packages/assets/build/cli.js lint-source",
    "assets:typecheck": "pnpm --filter @chassis-ui/assets typecheck",
    "assets:contract": "node packages/assets/build/cli.js contract",
    "assets:verify": "node packages/assets/build/cli.js verify",
    "assets:test": "pnpm test",
    "assets:site": "node packages/assets/build/cli.js build --clean --brand chassis --app docs",
    "assets:validate": "node packages/assets/build/cli.js validate",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "pnpm assets:site && pnpm astro:build && pnpm site:pagefind",
    "site:clean": "rm -rf _site && pnpm --filter chassis-assets-site clean",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:fusv && pnpm site:lint:stylelint && pnpm site:lint:prettier",
    "site:lint:fusv": "find-unused-sass-variables packages/site/src/scss/",
    "site:lint:eslint": "eslint packages/site --cache --cache-location .cache/.eslintcache --report-unused-disable-directives",
    "site:lint:stylelint": "stylelint packages/site/\"**/*.{css,scss}\" --cache --cache-location .cache/.stylelintcache",
    "site:lint:prettier": "prettier packages/site -c --cache",
    "site:lint:html": "node build/html-validate.js",
    "site:lint:vnu": "node build/vnu-jar.js",
    "site:pagefind": "pagefind --site _site --output-subdir assets/pagefind",
    "astro:dev": "pnpm --filter chassis-assets-site dev",
    "astro:build": "pnpm --filter chassis-assets-site build",
    "astro:preview": "pnpm --filter chassis-assets-site preview",
    "check": "pnpm check:astro && pnpm check:pnpm",
    "check:astro": "pnpm --filter chassis-assets-site check",
    "check:pnpm": "pnpm audit --audit-level moderate",
    "change-version": "node build/change-version.js",
    "lint:prettier": "prettier -c --cache ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^70.0.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.12.0",
    "globby": "^16.2.4",
    "html-validate": "^11.16.1",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vnu-jar": "26.7.3"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
