# The test fixture and its golden output are one-line text stand-ins for fonts and images,
# committed as they are, so that the tests run on a checkout without Git LFS. The assets
# themselves, Git LFS files, are in the vendor/assets submodule, chassis-ui/website-assets
packages/assets/test/fixtures/** !filter !diff !merge text eol=lf
packages/assets/test/golden/** !filter !diff !merge text eol=lf
