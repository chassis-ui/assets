---
import { getConfig } from '@libs/config'
import { getChassisDocsPath } from '@libs/path'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
---

<div class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content py-3xl md:py-6xl">
    <div class="row justify-content-center mb-3xl md:mb-6xl">
      <header class="section-header col xl:col-10 text-center">
        <p
          class="module-title fg-primary md:font-xl font-mass text-uppercase mb-xs md:mb-sm"
        >
          CHASSIS ASSETS
        </p>
        <h1 class="font-hero mb-sm md:mb-md lg:mb-lg">
          <span class="font-normal">Ship Assets to</span>
          <span class="d-block">Every Brand, Every Platform</span>
        </h1>
        <p class="font-lead mb-md md:mb-lg">
          Build system for processing design assets into platform-ready distributions. Handles file
          naming, resolution variants, and folder structure conventions across platforms.
        </p>
      </header>
    </div>

    <div
      class="section-features d-flex flex-column gap-md mb-md md:mb-lg col lg:col-6 lg:offset-3"
    >
      <!-- Code snippet -->
      <Code
        noToolbar
        lang="bash"
        code="git clone git@github.com:chassis-ui/assets.git"
        containerClass="md:mx-auto"
      />
      <!-- Buttons -->
      <div class="d-grid md:d-flex gap-md md:justify-content-center flex-wrap">
        <a href={getChassisDocsPath('')} class="button primary lg">
          <Icon name="book-open-outline" />
          <span>Get Started</span>
        </a>
        <a href={getConfig().repo} class="button default lg" target="_blank" rel="noopener">
          <Icon name="github-brand" />
          <span>View on GitHub</span>
        </a>
      </div>

      <!-- Version info -->
      <p class="fg-subtle mb-0 text-center font-md">
        Currently <strong>v{getConfig().current_version}</strong>
        <span class="px-2xs">&middot;</span>
        <a href={getConfig().repo + '/blob/main/CHANGELOG.md'} class="link-secondary text-nowrap"
          >Changes</a
        >
      </p>
    </div>
  </div>
</div>
